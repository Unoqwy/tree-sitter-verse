{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "verse",
      "camelcase": "Verse",
      "title": "Verse",
      "scope": "source.verse",
      "file-types": [
        "verse",
        "versetest"
      ],
      "injection-regex": "^verse$",
      "class-name": "TreeSitterVerse",
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "1.0.0",
    "license": "MIT",
    "description": "Verse (Unreal Engine language) grammar for tree-sitter",
    "authors": [
      {
        "name": "Unoqwy"
      }
    ],
    "links": {
      "repository": "https://github.com/Unoqwy/tree-sitter-verse"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": false,
    "zig": false
  }
}
